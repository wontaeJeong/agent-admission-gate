# Local development only. Generate your own password (at least 12 characters).
AAG_ENVIRONMENT=development
AAG_PUBLIC_URL=http://localhost:8000
AAG_DATABASE_URL=sqlite:///./data/aag.db
AAG_AUTH_MODE=local
AAG_BOOTSTRAP_ADMIN=admin
AAG_BOOTSTRAP_PASSWORD=
AAG_COOKIE_SECURE=false
AAG_ALLOWED_GIT_HOSTS=["github.com"]
AAG_BOARDS_ENABLED=false
# API keys and device-code issuance stay off until explicitly enabled.
AAG_API_KEYS_ENABLED=false
AAG_RUNNER_CONCURRENCY=2
AAG_QUEUE_CAPACITY=50
AAG_SCAN_TIMEOUT=300
AAG_CACHE_SECONDS=3600
AAG_SCANNER_REVISION=local-v1
AAG_OSV_ENABLED=false
AAG_GRYPE_DB_CACHE_DIR=
AAG_GRYPE_DB_AUTO_UPDATE=true
AAG_LLM_PROVIDER=disabled
AAG_LLM_MODEL=
AAG_LLM_BASE_URL=http://localhost:11434/v1
AAG_LLM_API_KEY=
AAG_BEDROCK_REGION=us-east-1
AAG_SYSTEMONE_RUNTIME=hosted
AAG_SYSTEMONE_REVIEW_THRESHOLD=0.35
# Deployment configuration: public values are examples, never internal addresses.
# AAG_AUTH_MODE=oidc
# AAG_OIDC_ISSUER=https://identity.example.com/realms/workspace
# AAG_OIDC_CLIENT_ID=agent-admission-gate
# AAG_OIDC_CLIENT_SECRET=
# AAG_OIDC_ADMIN_SUBJECTS=["exact-provider-subject-for-first-admin"]
# OIDC API keys/device issuance require verified synchronization, a Keycloak reader,
# and an authoritative upstream verifier. Until lifecycle monitoring is enabled,
# interactive sessions retain the existing local permissions and may be stale.
# AAG_OIDC_LIFECYCLE_SYNC_CONFIRMED=false
# AAG_OIDC_LIFECYCLE_CLIENT_ID=
# AAG_OIDC_LIFECYCLE_CLIENT_SECRET=
# AAG_OIDC_LIFECYCLE_CA_BUNDLE=/path/to/trusted-ca-bundle.pem
# AAG_OIDC_UPSTREAM_VERIFIER_URL=https://verifier.example.com/v1/identity/check
# AAG_OIDC_UPSTREAM_VERIFIER_SECRET=
# AAG_OIDC_ACCESS_GROUP_ID=
# AAG_OIDC_ADMIN_GROUP_ID=
# AAG_OIDC_REVIEWER_GROUP_ID=
